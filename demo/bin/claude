#!/usr/bin/env python3
"""Fake claude CLI for demo mode: reads the prompt, streams a canned answer."""
import os, sys, time

interactive = "-p" not in sys.argv
if interactive:  # kask: the prompt names the context file in the current directory
    prompt = sys.argv[-1]
    print("\x1b[2m╭─ Claude Code (demo) ─────────────────────────────╮\x1b[0m")
    print("\x1b[1m> \x1b[0m" + prompt + "\n")
    name = prompt.split(" ", 1)[0]
    data = open(name).read() if os.path.exists(name) else ""
    sys.stdout.write("\x1b[2m⏺ Read(" + name + ")\x1b[0m\n")
    if "cluster snapshot" in data:
        sys.stdout.write("\x1b[2m⏺ Bash(kubectl get events -n api --field-selector involvedObject.name=worker-5c8b7d4f9-hx2lp)\x1b[0m\n\n")
    sys.stdout.flush()
    time.sleep(0.8)
else:
    data = sys.stdin.read()
if "cluster snapshot" in data:
    answer = """Three things need attention on **use**, worst first:

1. **api/worker** — crash loop (42 restarts): `relation "orders_v2" does not exist`. The new image went out before the migration. Run the migration job, or pin the worker back.
2. **search** — `OutOfMemoryError: Java heap space`, OOM-killed 7×. Raise the heap (`MaxRAMPercentage=75`) and the memory limit.
3. **payments-api** — `ImagePullBackOff`: tag `2.4.1` doesn't exist in ghcr.io. Probably a typo in the HelmRelease values.

Also: `node-b1` is at 92% memory (alert firing) — the search pod lives there. Want me to look at what else runs on it?
"""
elif "search-" in data:
    answer = """**Diagnosis** — the JVM runs out of heap: the container limit allows it, but `-Xmx` (1536m) is too small for the `catalog` index, so the pod is OOM-killed and restarts.

**Evidence**
- `java.lang.OutOfMemoryError: Java heap space`
- event `OOMKilling` ×7, `GC overhead 92%`

**Fix**
1. In `apps/use/search/values.yaml` raise the heap: `JAVA_OPTS=-XX:MaxRAMPercentage=75` and `limits.memory: 3Gi`.
2. Merge, then `fwatch` to follow the rollout.
"""
else:
    answer = """**Diagnosis** — the worker exits on startup because the database schema it needs (`orders_v2`) doesn't exist yet: the new image (1.18.2) was deployed before the migration ran.

**Evidence**
- log: `pq: relation "orders_v2" does not exist` → `cannot start without schema v2, exiting`
- `CrashLoopBackOff`, 42 restarts; the second replica (older pod) is healthy

**Fix**
1. Run the `orders` migration job first (`apps/use/api/migrations-job.yaml`), or add it as a Flux `dependsOn` before `apps`.
2. Until then, pin the worker back to the previous image in `apps/use/api/worker.yaml`.
"""
for word in answer.split(" "):
    sys.stdout.write(word + " ")
    sys.stdout.flush()
    time.sleep(0.025)
print()

if interactive:
    print("\n")
    try:
        while True:
            line = input("\x1b[1m> \x1b[0m")
            if line.strip() in ("/exit", "exit"):
                break
            print("\x1b[2m(demo: no real model behind this)\x1b[0m\n")
    except (EOFError, KeyboardInterrupt):
        pass
