#!/usr/bin/env python3
"""Fake flux CLI for demo mode: only `flux diff kustomization`."""
import sys
args = sys.argv[1:]
if args[:2] != ["diff", "kustomization"]:
    sys.exit("demo flux: only 'diff kustomization' is simulated")
name = args[2] if len(args) > 2 else ""
if name != "apps":
    sys.exit(0)
print("""► Deployment/api/api drifted
spec.template.spec.containers.app.image
  ± value change
    - ghcr.io/acme/api:1.18.2
    + ghcr.io/acme/api:1.19.0
spec.template.spec.containers.app.resources.limits.memory
  ± value change
    - 512Mi
    + 768Mi
► ConfigMap/api/api-flags created""")
sys.exit(1)
