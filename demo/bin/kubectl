NODES = [("node-a1", 0.62, 0.71), ("node-a2", 0.48, 0.83), ("node-b1", 0.35, 0.92)]


def nodes():
    out = []
    for name, _, mem in NODES:
        conds = [{"type": "Ready", "status": "True"},
                 {"type": "MemoryPressure", "status": "True" if mem > 0.9 else "False"},
                 {"type": "DiskPressure", "status": "False"}]
        out.append({"metadata": {"name": name, "creationTimestamp": ts(120 * 86400),
                                 "labels": {"node-role.kubernetes.io/worker": ""}},
                    "spec": {}, "status": {"conditions": conds,
                                           "capacity": {"cpu": "16", "memory": "64Gi", "pods": "110"},
                                           "allocatable": {"cpu": "15800m", "memory": "62Gi", "pods": "110"},
                                           "nodeInfo": {"kubeletVersion": "v1.30.4"}}})
    return out


def ts(ago):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - ago))


WARNINGS = [
    ("api", "Pod", "worker-5c8b7d4f9-hx2lp", "BackOff", "Back-off restarting failed container app in pod worker-5c8b7d4f9-hx2lp", 380),
    ("search", "Pod", "search-6b4f8d7c9-r2lgn", "OOMKilling", "Memory cgroup out of memory: Killed process 4121 (java) total-vm:6.1GB, anon-rss:2.0GB", 7),
    ("payments", "Pod", "payments-api-6f7c8d9b5-kz4lp", "Failed", "Failed to pull image \"ghcr.io/acme/payments-api:2.4.1\": not found", 12),
