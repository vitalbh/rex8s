    ("web", "Ingress", "web", "Sync", "Error: endpoints \"web-canary\" not found", 3),
    ("payments", "HelmRelease", "payments-api", "UpgradeFailed", "Helm upgrade failed: context deadline exceeded", 4),
]


def event(i, ns, kind, name, reason, msg, count, ago=30):
    return {"metadata": {"uid": "demo-%d" % i, "namespace": ns}, "type": "Warning" if reason not in ("ReconciliationSucceeded", "Pulled", "Started") else "Normal",
            "involvedObject": {"kind": kind, "name": name}, "reason": reason, "message": msg,
            "count": count, "lastTimestamp": ts(ago)}


def events(flags):
    sel = flags.get("--field-selector", "")
    ns = None if "-A" in flags else flags.get("-n")
    want_name = None
    for part in sel.split(","):
        if part.startswith("involvedObject.name="):
            want_name = part.split("=", 1)[1]
    evs = [event(i, *w, ago=40 + i * 25) for i, w in enumerate(WARNINGS)]
    evs.append(event(90, "flux-system", "Kustomization", "apps", "ReconciliationSucceeded",
                     "Reconciliation finished in 4.2s, next run in 5m0s", 1, 50))
    if want_name:
        evs = [e for e in evs if e["involvedObject"]["name"] == want_name]
    if "type=Warning" in sel:
        evs = [e for e in evs if e["type"] == "Warning"]
    if ns:
        evs = [e for e in evs if e["metadata"]["namespace"] == ns]
    return evs


