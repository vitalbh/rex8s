# ── main ─────────────────────────────────────────────────────────────────
def main():
    flags, pos, rest = parse(sys.argv[1:])
    ctx = current_context(flags)
    if pos[:2] == ["config", "use-context"] and len(pos) > 2:
        path = flags.get("--kubeconfig") or os.environ.get("KUBECONFIG", "").split(":")[-1]
        text = open(path).read()
        text = re.sub(r"(?m)^current-context: .*$", "current-context: " + pos[2], text, count=1)
        open(path, "w").write(text)
        print('Switched to context "%s".' % pos[2])
        return
    if pos[:1] == ["config"]:
        print("Property set.")
        return
    if ctx not in CLUSTERS:
        die("error: context \"%s\" does not exist (demo mode only knows acme-* contexts)" % ctx)
    if CLUSTERS[ctx].get("expired"):
        die("error: You must be logged in to the server (Unauthorized)")
    verb = pos[0] if pos else ""
    ns = None if "-A" in flags else flags.get("-n", flags.get("--namespace"))
    out = flags.get("-o", flags.get("--output", ""))

    if verb == "auth":
        print("user/demo@example.com")
    elif verb == "get" and len(pos) > 1:
        res = pos[1]
        if res.startswith("/api/v1/namespaces/monitoring/services/alertmanager"):
            json.dump(ALERTS, sys.stdout)
            return
        if res.startswith("/api"):
            die("Error from server (NotFound): the server could not find the requested resource")
        if res.startswith("certificates"):
            CERTS[0]["status"]["notAfter"] = ts(-6 * 86400)
            CERTS[1]["status"]["notAfter"] = ts(-70 * 86400)
            json.dump({"items": CERTS}, sys.stdout)
            return
        if res in ("ns", "namespaces", "namespace"):
            print("\n".join(NAMESPACES))
        elif "gitrepositories" in res and "kustomizations" not in res:
            objs = [o for o in flux_objects(ctx, start_clock=True) if o["kind"] == "GitRepository"]
            json.dump({"items": objs}, sys.stdout)
        elif "kustomizations" in res or "helmreleases" in res:
            objs = flux_objects(ctx)
            kinds = set()
            for part in res.split(","):
                kinds.add({"kustomizations": "Kustomization", "helmreleases": "HelmRelease",
                           "gitrepositories": "GitRepository"}.get(part.split(".")[0], part))
            objs = [o for o in objs if o["kind"] in kinds]
            if len(pos) > 2:  # a single object (reconcile polling)
                one = [o for o in objs if o["metadata"]["name"] == pos[2]]
                if not one:
                    die('Error from server (NotFound): "%s" not found' % pos[2])
                json.dump(one[0], sys.stdout)
            else:
                json.dump({"items": objs}, sys.stdout)
        elif res.startswith("deployments"):
            json.dump({"items": workloads(ctx)}, sys.stdout)
        elif res in ("pods", "pod", "po"):
            json.dump({"items": select(pods(ns), flags.get("-l") or flags.get("--selector"))}, sys.stdout)
        elif res in ("services", "svc", "service"):
            json.dump({"items": services(ns)}, sys.stdout)
        elif res in ("jobs", "job", "jobs.batch"):
            json.dump({"items": jobs_and_crons(ns)[0]}, sys.stdout)
        elif res in ("cronjobs", "cronjob", "cj", "cronjobs.batch"):
            json.dump({"items": jobs_and_crons(ns)[1]}, sys.stdout)
        elif res in ("nodes", "node", "no"):
            json.dump({"items": nodes()}, sys.stdout)
        elif res in ("events", "ev"):
            evs = events(flags)
            if "-w" in flags or "--watch" in flags:
                for e in evs:
                    print(json.dumps(e, indent=4))
                sys.stdout.flush()
                i = 0
                while True:  # a warning now and then, like a live cluster
                    time.sleep(4)
                    w = WARNINGS[i % len(WARNINGS)]
                    print(json.dumps(event(100 + i, w[0], w[1], w[2], w[3], w[4], w[5] + i + 1, 0), indent=4))
                    sys.stdout.flush()
                    i += 1
            else:
                json.dump({"items": evs}, sys.stdout)
        else:
            json.dump({"items": []}, sys.stdout)
    elif verb == "describe" and "fluxcd.io" in (pos[1] if len(pos) > 1 else ""):
        kind = pos[1].split(".")[0]
        name = pos[2] if len(pos) > 2 else ""
        print(FLUX_DESCRIBE.format(name=name, ns=ns or "flux-system", kind={"kustomizations": "Kustomization", "helmreleases": "HelmRelease", "gitrepositories": "GitRepository"}.get(kind, kind),
                                   api=pos[1].split(".", 1)[1] if "." in pos[1] else "fluxcd.io"))
    elif verb == "describe":
        name = pos[2] if len(pos) > 2 else "pod"
        app = name.split("-")[0]
        print(DESCRIBE.format(name=name, ns=ns or "api", app=app, rs="-".join(name.split("-")[:2])))
    elif verb == "top" and len(pos) > 1 and pos[1] in ("nodes", "node", "no"):
        for name, cpu, mem in NODES:
            print("%s   %dm   %d%%   %dMi   %d%%" % (name, int(cpu * 15800), int(cpu * 100), int(mem * 63488), int(mem * 100)))
    elif verb == "create" and len(pos) > 2 and pos[1] == "job":
        print("job.batch/%s created" % pos[2])
    elif verb == "delete" and len(pos) > 2:
        print('%s.batch "%s" deleted' % (pos[1], pos[2]))
    elif verb == "logs":
        logs(pos, flags)
    elif verb == "annotate":
        for a in pos:
            if a.startswith("reconcile.fluxcd.io/requestedAt="):
                name = pos[2] if len(pos) > 2 else ""
                open(os.path.join(STATE, "reconcile-" + name), "w").write(a.split("=", 1)[1] + "|" + str(time.time()))
        print("%s annotated" % (pos[1] if len(pos) > 1 else "resource"))
    elif verb == "patch":
        print("%s/%s patched" % (pos[1] if len(pos) > 1 else "resource", pos[2] if len(pos) > 2 else ""))
    elif verb == "exec" and rest and "-it" not in flags and "-i" not in flags:
        name = pos[1] if len(pos) > 1 else "pod"
        if rest[:2] == ["nginx", "-s"]:
            print("2026/11/05 15:40:02 [notice] 1#1: signal process started")
        else:
            print("ran %s in %s" % (" ".join(rest), name))
    elif verb == "exec":
        name = pos[1] if len(pos) > 1 else "pod"
        os.execvpe("/bin/sh", ["/bin/sh", "-i"], dict(os.environ, PS1="app@%s:/app$ " % name, ENV=""))
    elif verb == "port-forward":
        mapping = pos[2] if len(pos) > 2 else "8080:8080"
        local, _, remote = mapping.partition(":")
        print("Forwarding from 127.0.0.1:%s -> %s\nForwarding from [::1]:%s -> %s" % (local, remote, local, remote))
        sys.stdout.flush()
        while True:
            time.sleep(3600)
    else:
        die("demo kubectl: '%s' isn't simulated" % " ".join(sys.argv[1:]))


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
