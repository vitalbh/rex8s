def logs(pos, flags):
    name = pos[1] if len(pos) > 1 else ""
    name = name.split("/", 1)[-1]
    key = ("worker" if name.startswith("worker") else "search" if name.startswith("search")
           else "invoice" if name.startswith("invoice") else "migrate" if name.startswith("db-migrate") else "default")
    lines = LOGS_EXTRA.get(key) or LOGS[key]
    prefix = "[pod/%s/app] " % name if "--prefix" in flags else ""
    if name.startswith("payments-api"):
        die("Error from server (BadRequest): container \"app\" in pod \"%s\" is waiting to start: trying and failing to pull image" % name)
    if "--previous" in flags and key == "default":
        die("Error from server (BadRequest): previous terminated container \"app\" in pod \"%s\" not found" % name)
    for l in lines:
        print(prefix + l)
    if "-f" in flags or "--follow" in flags:
        sys.stdout.flush()
        i = 0
        while True:
            time.sleep(1.4)
            print(prefix + LOGS["default"][i % 4])
            sys.stdout.flush()
            i += 1


