#!/usr/bin/env python3
"""Fake kubectl for rex8s demo mode: answers the calls rex8s makes with
made-up data for example.com clusters. Nothing here talks to a real cluster.

The fwatch story is time based: the first GitRepository query starts a clock
(reset after 90s of inactivity); the source fetches HEAD after ~4s, the
Kustomizations apply it and a Deployment rolls out over the next ~12s.
"""
import json, os, re, subprocess, sys, tempfile, time

STATE = os.path.join(tempfile.gettempdir(), "rex8s-demo")
os.makedirs(STATE, exist_ok=True)
OLD_SHA = "9c41e07b2d6a5f3e8b1c0d4a7e6f5b3c2a1d0e9f"

CLUSTERS = {
    "acme-prod-use": {"short": "use", "offset": 0},
    "acme-prod-euw": {"short": "euw", "offset": 3},
    "acme-staging": {"short": "staging", "offset": 1},
    "acme-prod-sa": {"short": "sa", "expired": True},
}
NAMESPACES = ["api", "web", "payments", "search", "monitoring", "ingress-nginx", "flux-system", "kube-system"]


def die(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


# ── arguments ────────────────────────────────────────────────────────────
VALUE_FLAGS = {"--kubeconfig", "--context", "-n", "--namespace", "-o", "--output", "--field-selector",
               "-l", "--selector", "-c", "--container", "--tail", "--type", "-p", "--patch"}


def parse(argv):
    flags, pos, rest = {}, [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest = argv[i + 1:]
            break
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            flags[k] = v
        elif a in VALUE_FLAGS and i + 1 < len(argv):
            flags[a] = argv[i + 1]
            i += 1
        elif a.startswith("-"):
            flags[a] = True
        else:
            pos.append(a)
        i += 1
    return flags, pos, rest


def current_context(flags):
    if "--context" in flags:
        return flags["--context"]
    for f in (os.environ.get("KUBECONFIG") or "").split(":"):
        try:
            for line in open(f):
                if line.startswith("current-context:"):
                    return line.split(":", 1)[1].strip().strip('"')
        except OSError:
            pass
    return "acme-prod-use"


# ── fwatch clock ─────────────────────────────────────────────────────────
def head_sha():
    try:
        return subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, timeout=3).stdout.strip() or OLD_SHA
    except Exception:
        return OLD_SHA


def clock(start=False):
    path = os.path.join(STATE, "fwatch-t0")
    now = time.time()
    try:
        last = os.path.getmtime(path)
        t0 = float(open(path).read())
    except (OSError, ValueError):
        last, t0 = 0, None
    if start and (t0 is None or now - last > 90):
        t0 = now
    if t0 is None:
        return 999.0  # no fwatch running: everything settled
    open(path, "w").write(str(t0))  # touch: keep the story alive while polled
    return now - t0


def rev(sha):
    return "main@sha1:" + sha


# ── flux ─────────────────────────────────────────────────────────────────
def cond(status, reason="", msg=""):
    return [{"type": "Ready", "status": status, "reason": reason, "message": msg}]


def flux_objects(ctx, start_clock=False):
    c = CLUSTERS[ctx]
    e = clock(start_clock) - c.get("offset", 0)
    new = head_sha()
    src_rev = rev(new if e >= 4 else OLD_SHA)
    objs = [{
        "kind": "GitRepository", "metadata": {"name": "flux-system", "namespace": "flux-system", "generation": 1},
        "spec": {"url": "https://github.com/acme/fleet.git", "ref": {"branch": "main"}},
        "status": {"observedGeneration": 1, "artifact": {"revision": src_rev},
                   "conditions": cond("True", "Succeeded", "stored artifact for revision '%s'" % src_rev)},
    }]
    short = c["short"]
    for name, path, applied_at in (("flux-system", "./clusters/" + short, 6), ("infra", "./infrastructure", 7), ("apps", "./apps/" + short, 8)):
        applied = rev(new) if e >= applied_at else rev(OLD_SHA)
        status = cond("True", "ReconciliationSucceeded", "Applied revision: " + applied)
        if 4 <= e < applied_at:
            status = cond("Unknown", "Progressing", "Reconciliation in progress")
        spec = {"path": path, "sourceRef": {"kind": "GitRepository", "name": "flux-system"}, "interval": "5m"}
        if ctx == "acme-staging" and name == "apps":
            spec["suspend"] = True
        objs.append({"kind": "Kustomization", "metadata": {"name": name, "namespace": "flux-system", "generation": 1},
                     "spec": spec, "status": {"observedGeneration": 1, "lastAppliedRevision": applied,
                                              "lastAttemptedRevision": applied, "conditions": status,
                                              "lastHandledReconcileAt": handled("Kustomization", name)}})
    hr_ready = cond("True", "UpgradeSucceeded", "Helm upgrade succeeded for release monitoring/kube-prometheus-stack.v14")
    if ctx == "acme-prod-euw":
        hr_ready = cond("False", "UpgradeFailed",
                        "Helm upgrade failed for release payments/payments-api with chart payments-api@2.4.1: "
                        "context deadline exceeded; upgrade retries exhausted")
    objs.append({"kind": "HelmRelease",
                 "metadata": {"name": "payments-api" if ctx == "acme-prod-euw" else "kube-prometheus-stack",
                              "namespace": "payments" if ctx == "acme-prod-euw" else "monitoring", "generation": 3,
                              "labels": {"kustomize.toolkit.fluxcd.io/name": "apps",
                                         "kustomize.toolkit.fluxcd.io/namespace": "flux-system"}},
                 "spec": {}, "status": {"observedGeneration": 3, "conditions": hr_ready,
                                        "lastAppliedRevision": "2.4.1"}})
    return objs


def handled(kind, name):
    try:
        token, at = open(os.path.join(STATE, "reconcile-" + name)).read().split("|")
        return token if time.time() - float(at) > 3 else ""
    except (OSError, ValueError):
        return ""


def workloads(ctx):
    c = CLUSTERS[ctx]
    e = clock(start=True) - c.get("offset", 0)  # fwatch reads these first (baseline)
    labels = {"kustomize.toolkit.fluxcd.io/name": "apps", "kustomize.toolkit.fluxcd.io/namespace": "flux-system"}

    def dep(ns, name, replicas, gen, updated, available, extra=None, kind="Deployment"):
        d = {"kind": kind, "metadata": {"name": name, "namespace": ns, "generation": gen, "labels": labels},
             "spec": {"replicas": replicas, "selector": {"matchLabels": {"app": name}}},
             "status": {"observedGeneration": gen, "updatedReplicas": updated, "availableReplicas": available,
                        "readyReplicas": available, "conditions": []}}
        if extra:
            d["status"].update(extra)
        return d

    if e < 8:
        api = dep("api", "api", 3, 11, 3, 3)
    elif e < 16:
        step = int((e - 8) / 2.5) + 1
        api = dep("api", "api", 3, 12, min(3, step), min(3, step) - (0 if step >= 3 else 1))
    else:
        api = dep("api", "api", 3, 12, 3, 3)
    # the edge proxy is named differently per cluster (krun demo)
    nginx = {"acme-prod-use": "nginx", "acme-prod-euw": "nginx-euw"}.get(ctx, "nginx-edge")
    return [api, dep("web", "web", 4, 30, 4, 4), dep("search", "search", 2, 7, 2, 2),
            dep("api", "worker", 2, 5, 2, 1), dep("web", nginx, 2, 9, 2, 2)]


# ── pods, services, events, logs ─────────────────────────────────────────
def pod(ns, name, phase="Running", ready=(1, 1), restarts=0, waiting=None, age_h=26, containers=("app",)):
    created = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - age_h * 3600))
    statuses = []
    for i, cn in enumerate(containers):
        st = {"name": cn, "ready": i < ready[0], "restartCount": restarts if i == 0 else 0, "state": {}}
        if waiting and i == 0:
            st["state"] = {"waiting": {"reason": waiting}}
        statuses.append(st)
    return {"metadata": {"name": name, "namespace": ns, "creationTimestamp": created},
            "spec": {"containers": [{"name": c} for c in containers]},
            "status": {"phase": phase, "containerStatuses": statuses}}


def pods(ns):
    all_pods = [
        pod("api", "api-7d9f6c5b8-4kq2x", age_h=2), pod("api", "api-7d9f6c5b8-9ws7d", age_h=2),
        pod("api", "api-7d9f6c5b8-zt5mr", age_h=2),
        pod("api", "worker-5c8b7d4f9-hx2lp", ready=(0, 1), restarts=42, waiting="CrashLoopBackOff", age_h=5),
        pod("api", "worker-5c8b7d4f9-q8vnt", age_h=5),
        pod("api", "nightly-sync-29871540-mbk4c", phase="Succeeded", ready=(0, 1), age_h=9),
        pod("api", "redis-0", containers=("redis", "metrics"), ready=(2, 2), age_h=300),
        pod("search", "search-6b4f8d7c9-r2lgn", ready=(0, 1), restarts=7, waiting="CrashLoopBackOff", age_h=30),
        pod("search", "search-6b4f8d7c9-tq9wd", age_h=30),
        pod("web", "web-58c9f7b6d4-2jx8p", age_h=50), pod("web", "web-58c9f7b6d4-7mfkz", age_h=50),
        pod("payments", "payments-api-6f7c8d9b5-kz4lp", ready=(0, 1), waiting="ImagePullBackOff", age_h=1),
        pod("monitoring", "prometheus-0", containers=("prometheus", "config-reloader"), ready=(2, 2), age_h=700),
        pod("web", "nginx-7c9d8f6b5-k2x4p", age_h=80), pod("web", "nginx-7c9d8f6b5-w8m3q", age_h=80),
    ]
    return [p for p in all_pods if ns in (None, p["metadata"]["namespace"])]


def select(items, selector):
    """-l app=X: the demo's pods are named after their workload."""
    if not selector or not selector.startswith("app="):
        return items
    app = selector.split("=", 1)[1]
    if app.startswith("nginx"):
        app = "nginx"
    return [p for p in items if p["metadata"]["name"].startswith(app + "-")]


def services(ns):
    def svc(n, name, ports, t="ClusterIP"):
        return {"metadata": {"name": name, "namespace": n}, "spec": {"type": t, "ports": [
            {"name": pn, "port": pp, "protocol": "TCP"} for pn, pp in ports]}}
    all_svcs = [svc("api", "api", [("http", 8080), ("grpc", 9090)]), svc("api", "redis", [("redis", 6379)]),
                svc("web", "web", [("http", 80)]), svc("search", "search", [("http", 9200)]),
                svc("payments", "payments-api", [("http", 8080)]),
                svc("monitoring", "prometheus", [("web", 9090)]),
                svc("monitoring", "alertmanager", [("web", 9093)]), svc("monitoring", "grafana", [("http", 3000)]),
                svc("ingress-nginx", "ingress-nginx-controller", [("http", 80), ("https", 443)], "LoadBalancer")]
    return [s for s in all_svcs if ns in (None, s["metadata"]["namespace"])]


def jobs_and_crons(ns):
    def cron(n, name, schedule, last_ago, ok_ago, suspend=False):
        c = {"kind": "CronJob", "metadata": {"name": name, "namespace": n, "creationTimestamp": ts(90 * 86400)},
             "spec": {"schedule": schedule, "suspend": suspend}, "status": {}}
        if last_ago is not None:
            c["status"]["lastScheduleTime"] = ts(last_ago)
        if ok_ago is not None:
            c["status"]["lastSuccessfulTime"] = ts(ok_ago)
        return c

    def job(n, name, owner, start_ago, dur, result, msg=""):
        j = {"kind": "Job", "metadata": {"name": name, "namespace": n, "creationTimestamp": ts(start_ago)},
             "spec": {"completions": 1, "parallelism": 1, "backoffLimit": 3},
             "status": {"startTime": ts(start_ago)}}
        if owner:
            j["metadata"]["ownerReferences"] = [{"kind": "CronJob", "name": owner}]
        if result == "ok":
            j["status"].update({"succeeded": 1, "completionTime": ts(start_ago - dur),
                                "conditions": [{"type": "Complete", "status": "True"}]})
        elif result == "fail":
            j["status"].update({"failed": 4, "conditions": [{"type": "Failed", "status": "True",
                                "lastTransitionTime": ts(start_ago - 95),
                                "reason": "BackoffLimitExceeded", "message": msg or "Job has reached the specified backoff limit"}]})
        else:
            j["status"].update({"active": 1})
        return j

    crons = [cron("api", "nightly-sync", "0 3 * * *", 9 * 3600, 9 * 3600 - 250),
             cron("payments", "invoice-export", "*/30 * * * *", 600, 2 * 3600 + 200),
             cron("web", "sitemap", "0 */6 * * *", 3 * 86400, 3 * 86400, suspend=True),
             cron("search", "reindex", "0 2 * * 0", 4 * 86400, 4 * 86400 - 1800)]
    jobs = [job("payments", "invoice-export-29872010", "invoice-export", 600, 0, "fail"),
            job("payments", "invoice-export-29871980", "invoice-export", 2400, 0, "fail"),
            job("payments", "invoice-export-29871950", "invoice-export", 2 * 3600 + 300, 100, "ok"),
            job("search", "reindex-manual-7xk2p", "reindex", 200, 0, "run"),
            job("api", "nightly-sync-29871540", "nightly-sync", 9 * 3600, 250, "ok"),
            job("api", "db-migrate-v2", None, 5 * 3600, 0, "fail", "Job has reached the specified backoff limit"),
            job("web", "sitemap-29868120", "sitemap", 3 * 86400, 95, "ok")]
    keep = lambda o: ns in (None, o["metadata"]["namespace"])
    return [j for j in jobs if keep(j)], [c for c in crons if keep(c)]


