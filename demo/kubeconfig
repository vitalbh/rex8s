# Demo kubeconfig: example.com clusters answered by demo/bin/kubectl. No real endpoints, no secrets.
apiVersion: v1
kind: Config
current-context: acme-prod-use
clusters:
- name: use
  cluster: {server: "https://k8s.us-east.example.com:6443"}
- name: euw
  cluster: {server: "https://k8s.eu-west.example.com:6443"}
- name: staging
  cluster: {server: "https://k8s.staging.example.com:6443"}
- name: sa
  cluster: {server: "https://k8s.sa-east.example.com:6443"}
users:
- name: demo
  user: {token: demo-token-not-a-secret}
contexts:
- name: acme-prod-use
  context: {cluster: use, user: demo, namespace: api}
- name: acme-prod-euw
  context: {cluster: euw, user: demo}
- name: acme-staging
  context: {cluster: staging, user: demo}
- name: acme-prod-sa
  context: {cluster: sa, user: demo}
