# kjunk: leftovers on every cluster, mark and delete
Output docs/kjunk.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 480
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kjunk"
Enter
Sleep 4s
Type "job"
Sleep 1200ms
Ctrl+A
Sleep 1200ms
Enter
Sleep 1500ms
Type "y"
Sleep 400ms
Enter
Sleep 3s
