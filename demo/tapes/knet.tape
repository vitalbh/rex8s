# knet: network tools from inside the namespace
Output docs/knet.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 460
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "knet"
Enter
Sleep 1500ms
Type "use"
Enter
Sleep 2s
Type "dig api"
Enter
Sleep 1200ms
Type "curl -s http://api.api:8080/health"
Enter
Sleep 1500ms
Type "exit"
Enter
Sleep 2s
