# kpf: port-forward in the background, kubectl only while in use; the client command for databases
Output docs/kpf.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 560
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kpf -A grafana staging"
Enter
Sleep 3500ms
Type "kpf -A"
Enter
Sleep 3s
Type "orders"
Sleep 1500ms
Enter
Sleep 3500ms
Type "kpf -l"
Enter
Sleep 3500ms
Escape
Sleep 800ms
