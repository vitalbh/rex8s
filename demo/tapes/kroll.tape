# kroll: restart the workloads you mark and follow the rollouts
Output docs/kroll.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 560
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kroll"
Enter
Sleep 3s
Type "api/api"
Sleep 1200ms
Ctrl+A
Sleep 1500ms
Enter
Sleep 1500ms
Type "y"
Sleep 500ms
Enter
Sleep 13s
