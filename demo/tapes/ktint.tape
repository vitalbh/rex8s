# ktint: the production background, previewed as you move
Output docs/ktint.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 440
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "ktint"
Enter
Sleep 1500ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 1500ms
Escape
Sleep 500ms
