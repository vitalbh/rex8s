# kver: which version runs where; differences first
Output docs/kver.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 480
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kver"
Enter
Sleep 5s
Type "kver -d api"
Enter
Sleep 4s
