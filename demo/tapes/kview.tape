# kview: the clusters like k9s — tabs, live lists, a key per action
Output docs/kview.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 680
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kview -A"
Enter
Sleep 4s
Down
Sleep 400ms
Down
Sleep 400ms
Down
Sleep 1s
Type "/"
Sleep 300ms
Type "worker"
Sleep 1200ms
Enter
Sleep 1s
Type "d"
Sleep 3s
Down 6
Sleep 1500ms
Type "q"
Sleep 1s
Escape
Sleep 800ms
Tab
Sleep 3s
Down
Sleep 400ms
Down
Sleep 1s
Enter
Sleep 3s
Type "4"
Sleep 3s
Type "6"
Sleep 3500ms
Type "5"
Sleep 3s
Type "q"
Sleep 500ms
