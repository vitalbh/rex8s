# kwarn -A: the Warning events of every cluster, live, in one stream
Output docs/kwarn.gif
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 640
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms
Hide
Type "export PS1='demo $ ' && clear"
Enter
Sleep 300ms
Show
Type "kwarn -A"
Enter
Sleep 14s
Ctrl+C
Sleep 500ms
